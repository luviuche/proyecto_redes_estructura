# Plantilla de variables de entorno.
# 1. Copia este archivo como .env  ->  cp .env.example .env
# 2. Reemplaza el valor con tu clave real del API de Claude.
# 3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
#
# Sin clave, el agente funciona igual en modo fallback (solo capa determinista).

ANTHROPIC_API_KEY=tu_clave_api_aqui
